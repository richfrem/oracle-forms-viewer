<?xml version="1.0" encoding="UTF-8"?>
<Module version="122010400" xmlns="http://xmlns.oracle.com/Forms">
   <MenuModule Name="OFW_EMP_MENU" MainMenu="MAIN_MENU">
      <ProgramUnit Name="FILTER_BY_DEPARTMENT" ProgramUnitType="Procedure" ProgramUnitText="PROCEDURE filter_by_department(p_dept IN VARCHAR2) IS&#10;BEGIN&#10;   -- Apply department filter to the EMP block and re-query&#10;   COPY(NULL, 'CONTROL.SEARCH_NAME');&#10;   IF p_dept IS NULL OR p_dept = 'ALL' THEN&#10;      SET_BLOCK_PROPERTY('EMP', DEFAULT_WHERE, '');&#10;   ELSE&#10;      SET_BLOCK_PROPERTY('EMP', DEFAULT_WHERE, 'UPPER(department) = UPPER(''' || p_dept || ''')');&#10;   END IF;&#10;   GO_BLOCK('EMP');&#10;   EXECUTE_QUERY;&#10;END;"/>
      <ProgramUnit Name="APPLY_MERIT_RAISE" ProgramUnitType="Procedure" ProgramUnitText="PROCEDURE apply_merit_raise(p_pct IN NUMBER) IS&#10;   v_sal NUMBER;&#10;BEGIN&#10;   -- Increase the current employee salary by p_pct percent using NAME_IN / COPY&#10;   IF NAME_IN('EMP.EMP_ID') IS NOT NULL THEN&#10;      v_sal := ROUND(TO_NUMBER(NAME_IN('EMP.SALARY')) * (1 + (p_pct / 100)), 2);&#10;      COPY(TO_CHAR(v_sal), 'EMP.SALARY');&#10;      MESSAGE('Applied ' || TO_CHAR(p_pct) || '% merit increase to ' || NAME_IN('EMP.FULL_NAME') || '. Click Save to commit.');&#10;   END IF;&#10;END;"/>
      <ProgramUnit Name="PROMOTE_EMPLOYEE" ProgramUnitType="Procedure" ProgramUnitText="PROCEDURE promote_employee IS&#10;   v_title VARCHAR2(200);&#10;BEGIN&#10;   v_title := NAME_IN('EMP.JOB_TITLE');&#10;   IF NAME_IN('EMP.EMP_ID') IS NOT NULL AND INSTR(UPPER(v_title), 'SENIOR') = 0 THEN&#10;      COPY('Senior ' || v_title, 'EMP.JOB_TITLE');&#10;      MESSAGE('Promoted ' || NAME_IN('EMP.FULL_NAME') || ' to Senior ' || v_title || '.');&#10;   END IF;&#10;END;"/>

