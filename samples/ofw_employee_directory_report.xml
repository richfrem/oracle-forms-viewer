<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report SYSTEM "reports.dtd">
<report DTDVersion="9.0.4.0.0" name="OFW_EMP_DIRECTORY" title="Employee Directory &amp; Merit Bonus Report (OFW_DEMO_EMPLOYEES)" unitOfMeasurement="inch">
  <data>
    <dataSource name="Q_DEPTS">
      <select>SELECT DISTINCT DEPARTMENT AS DEPARTMENT_NAME FROM OFW_DEMO_EMPLOYEES ORDER BY DEPARTMENT</select>
      <group name="G_DEPT">
        <dataItem name="DEPARTMENT_NAME" datatype="character" width="30" />
        <summary name="CS_DEPT_TOTAL_SALARY" source="SALARY" function="sum" reset="G_DEPT" />
        <summary name="CS_DEPT_EMP_COUNT" source="EMP_ID" function="count" reset="G_DEPT" />
      </group>
    </dataSource>
    <dataSource name="Q_EMP">
      <select>SELECT EMP_ID, FIRST_NAME, LAST_NAME, JOB_TITLE, DEPARTMENT, SALARY, HIRE_DATE FROM OFW_DEMO_EMPLOYEES ORDER BY LAST_NAME</select>
      <group name="G_EMP">
        <dataItem name="EMP_ID" datatype="number" width="10" />
        <dataItem name="FIRST_NAME" datatype="character" width="20" />
        <dataItem name="LAST_NAME" datatype="character" width="25" />
        <dataItem name="JOB_TITLE" datatype="character" width="35" />
        <dataItem name="DEPARTMENT" datatype="character" width="20" />
        <dataItem name="SALARY" datatype="number" width="12" />
        <dataItem name="HIRE_DATE" datatype="date" width="12" />
        <formula name="CF_BONUS" source=":SALARY * 0.10" datatype="number" />
        <summary name="CS_TOTAL_PAYROLL" source="SALARY" function="sum" reset="report" />
      </group>
    </dataSource>
    <link name="L_DEPT_EMP" parentGroup="G_DEPT" parentColumn="DEPARTMENT_NAME" childQuery="Q_EMP" childColumn="DEPARTMENT" condition="eq" />
  </data>
  <layout>
    <section name="MAIN_SECTION">
      <body>
        <frame name="M_HEADER_FRAME">
          <geometryInfo x="0.5" y="0.5" width="7.5" height="0.6" />
          <text name="B_TITLE">
            <geometryInfo x="0.5" y="0.5" width="7.5" height="0.4" />
            <textSegment><string>Employee Directory &amp; Merit Bonus Report (OFW_DEMO_EMPLOYEES)</string></textSegment>
          </text>
        </frame>
        <frame name="M_MASTER_FRAME">
          <geometryInfo x="0.5" y="1.2" width="7.5" height="6.0" />
          <repeatingFrame name="R_DEPT" source="G_DEPT" printDirection="down">
            <geometryInfo x="0.5" y="1.2" width="7.5" height="2.0" />
            <field name="F_DEPT_NAME" source="DEPARTMENT_NAME">
              <geometryInfo x="0.5" y="1.2" width="3.0" height="0.25" />
            </field>
            <repeatingFrame name="R_EMP" source="G_EMP" printDirection="down">
              <geometryInfo x="1.0" y="1.5" width="7.0" height="0.3" />
              <field name="F_EMP_ID" source="EMP_ID">
                <geometryInfo x="1.0" y="1.5" width="0.8" height="0.25" />
              </field>
              <field name="F_FIRST_NAME" source="FIRST_NAME">
                <geometryInfo x="1.9" y="1.5" width="1.2" height="0.25" />
              </field>
              <field name="F_LAST_NAME" source="LAST_NAME">
                <geometryInfo x="3.2" y="1.5" width="1.2" height="0.25" />
              </field>
              <field name="F_JOB_TITLE" source="JOB_TITLE">
                <geometryInfo x="4.5" y="1.5" width="1.6" height="0.25" />
              </field>
              <field name="F_SALARY" source="SALARY" formatMask="$#,##0.00">
                <geometryInfo x="6.2" y="1.5" width="1.0" height="0.25" />
              </field>
              <field name="F_BONUS" source="CF_BONUS" formatMask="$#,##0.00">
                <geometryInfo x="7.3" y="1.5" width="1.0" height="0.25" />
              </field>
            </repeatingFrame>
            <field name="F_DEPT_TOTAL_SALARY" source="CS_DEPT_TOTAL_SALARY" formatMask="$#,##0.00">
              <geometryInfo x="5.3" y="1.9" width="1.5" height="0.25" />
            </field>
            <field name="F_DEPT_EMP_COUNT" source="CS_DEPT_EMP_COUNT">
              <geometryInfo x="3.7" y="1.9" width="1.5" height="0.25" />
            </field>
          </repeatingFrame>
        </frame>
        <frame name="M_GRAND_TOTAL_FRAME">
          <geometryInfo x="0.5" y="7.5" width="7.5" height="0.8" />
          <field name="F_TOTAL_PAYROLL" source="CS_TOTAL_PAYROLL" formatMask="$#,##0.00">
            <geometryInfo x="5.3" y="7.5" width="1.5" height="0.25" />
          </field>
        </frame>
      </body>
    </section>
  </layout>
</report>
