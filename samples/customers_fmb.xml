    <!-- ==================== PL/SQL PROGRAM UNITS ==================== -->
    <ProgramUnit Name="CALCULATE_TIER" ProgramUnitType="Function">
      <ProgramUnitText>FUNCTION CALCULATE_TIER(p_lifetime_spend IN NUMBER) RETURN VARCHAR2 IS
BEGIN
  IF p_lifetime_spend &gt;= 50000 THEN
    RETURN 'PLATINUM';
  ELSIF p_lifetime_spend &gt;= 15000 THEN
    RETURN 'GOLD';
  ELSIF p_lifetime_spend &gt;= 5000 THEN
    RETURN 'SILVER';
  ELSE
    RETURN 'STANDARD';
  END IF;
END;</ProgramUnitText>
    </ProgramUnit>

    <ProgramUnit Name="APPLY_CREDIT_CHECK" ProgramUnitType="Procedure">
      <ProgramUnitText>PROCEDURE APPLY_CREDIT_CHECK(p_cust_id IN NUMBER) IS
  v_balance NUMBER := 0;
  v_limit   NUMBER := 0;
BEGIN
  SELECT NVL(SUM(invoice_amt), 0) INTO v_balance
    FROM customer_invoices
   WHERE customer_id = p_cust_id AND status = 'UNPAID';

  v_limit := NVL(:CUSTOMER_PROFILE.CREDIT_LIMIT, 0);

  IF v_balance &gt; v_limit THEN
    MESSAGE('Warning: Outstanding balance (' || v_balance || ') exceeds credit limit (' || v_limit || ')');
  ELSE
    MESSAGE('Credit check approved. Available buffer: ' || (v_limit - v_balance));
  END IF;
END;</ProgramUnitText>
    </ProgramUnit>

    <!-- ==================== FORM LEVEL TRIGGERS ==================== -->
    <Trigger Name="WHEN-NEW-FORM-INSTANCE" TriggerText="BEGIN&#10;  SET_WINDOW_PROPERTY(FORMS_MDI_WINDOW, WINDOW_STATE, MAXIMIZE);&#10;  GO_BLOCK('CUSTOMER_PROFILE');&#10;  EXECUTE_QUERY;&#10;END;"/>

    <Trigger Name="WHEN-TAB-PAGE-CHANGED" TriggerText="DECLARE&#10;  v_page VARCHAR2(30);&#10;BEGIN&#10;  v_page := GET_CANVAS_PROPERTY('CV_TABS', TOPMOST_TAB_PAGE);&#10;  IF v_page = 'PAGE_ORDERS' THEN&#10;    -- Lazy-load order metrics on demand&#10;    LOG_ACCOUNT_AUDIT(:CUSTOMER_PROFILE.CUSTOMER_ID, 'VIEW_ORDERS');&#10;  END IF;&#10;END;"/>
  </FormModule>
</Module>
