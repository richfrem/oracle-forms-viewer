      <Item Name="BTN_CREATE_ORDER" ItemType="Push Button" CanvasName="CV_TABS" TabPageName="PAGE_ORDERS" Label="+ Create New Order" XPosition="380" YPosition="295" Width="160" Height="26">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="CALL_FORM('orders_fmb', NO_HIDE, DO_REPLACE);"/>
