        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="COMMIT_FORM;&#10;IF :SYSTEM.FORM_STATUS = 'QUERY' THEN&#10;  MESSAGE('Account saved successfully.');&#10;END IF;"/>
      </Item>
