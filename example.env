# Local credentials for the Oracle reference stack and the Rust workbench.
# Copy this file to `.env` (git-ignored) and fill in the values. Never commit `.env`.
# Local development only: use throwaway-container passwords.

# Database admin password (set as ORACLE_PWD when the database container starts)
ORACLE_PWD=

# Test schema user for the Forms samples and the Rust workbench
DB_USER=
DB_PASSWORD=
DB_SERVICE=

# Read by the Rust server and CLI
OFW_DB_USER=
OFW_DB_PASSWORD=

# WebLogic admin (AdminServer console and boot.properties)
WLS_ADMIN_USER=
WLS_ADMIN_PASSWORD=

# Optional: host folder holding the Forms 14c Oracle Home. Leave empty for the default (oracle-reference-stack/oracle_home_14c).
# Windows: set it BEFORE installing, to a folder on Ubuntu's own disk, for example /home/<you>/oracle_home_14c. Never install into the repo folder (slow /mnt/c mount).
# Use an absolute path (no ~). See the setup skill's references/oracle-home-location.md.
OFW_ORACLE_HOME=