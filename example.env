# Local credentials for the Oracle reference stack and the Rust workbench.
# Copy this file to `.env` (git-ignored) and fill in the values. Never commit `.env`.
# Local development only: use throwaway-container passwords.

# Database admin password (set as ORACLE_PWD when the database container starts)
ORACLE_PWD=

# Test schema user for the Forms samples and the Rust workbench
DB_USER=
DB_PASSWORD=
DB_SERVICE=

# Read by the Rust server and CLI
OFW_DB_USER=
OFW_DB_PASSWORD=

# WebLogic admin (AdminServer console and boot.properties)
WLS_ADMIN_USER=
WLS_ADMIN_PASSWORD=