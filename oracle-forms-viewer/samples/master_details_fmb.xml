<?xml version="1.0" encoding="UTF-8"?>
<Module version="12.2.1.19.0" xmlns="http://xmlns.oracle.com/Forms">
  <FormModule Name="MASTER_DETAILS" Title="Oracle Form Builder - MASTER_DETAILS">
    <Coordinate CharacterCellWidth="8" CharacterCellHeight="16" CoordinateSystem="Real" RealUnit="Pixel" DefaultFontScaling="false"/>

    <!-- ==================== WINDOW DEFINITION ==================== -->
    <Window Name="WINDOW1" Title="WINDOW1" Width="780" Height="480" PrimaryCanvas="CANVAS4"/>

    <!-- ==================== MAIN CONTENT CANVAS: CANVAS4 ==================== -->
    <Canvas Name="CANVAS4" CanvasType="Content" Width="740" Height="440" WindowName="WINDOW1">
      <!-- Master Frame: Department Informations -->
      <Graphics Name="FRAME_DEPT" GraphicsType="Frame" FrameTitle="Department Informations" CanvasName="CANVAS4" XPosition="40" YPosition="25" Width="520" Height="140" Bevel="Inset"/>

      <!-- Detail Frame: Employees Information -->
      <Graphics Name="FRAME_EMP" GraphicsType="Frame" FrameTitle="Employees Information" CanvasName="CANVAS4" XPosition="40" YPosition="185" Width="660" Height="220" Bevel="Inset"/>
    </Canvas>

    <!-- ==================== MASTER BLOCK: DEPARTMENTS ==================== -->
    <Block Name="DEPARTMENTS" QueryDataSourceName="DEPARTMENTS" OrderByClause="DEPARTMENT_ID">
      <Item Name="DEPARTMENT_ID" ItemType="Text Item" DataType="Number" CanvasName="CANVAS4" Prompt="Department Id" PromptAttachmentEdge="Start" PromptAttachmentOffset="12" XPosition="180" YPosition="52" Width="130" Height="22" PrimaryKey="true" Required="true"/>
      <Item Name="DEPARTMENT_NAME" ItemType="Text Item" DataType="Char" CanvasName="CANVAS4" Prompt="Department Name" PromptAttachmentEdge="Start" PromptAttachmentOffset="12" XPosition="180" YPosition="80" Width="200" Height="22" Required="true"/>
      <Item Name="MANAGER_ID" ItemType="Text Item" DataType="Number" CanvasName="CANVAS4" Prompt="Manager Id" PromptAttachmentEdge="Start" PromptAttachmentOffset="12" XPosition="180" YPosition="108" Width="130" Height="22"/>
      <Item Name="LOCATION_ID" ItemType="Text Item" DataType="Number" CanvasName="CANVAS4" Prompt="Location Id" PromptAttachmentEdge="Start" PromptAttachmentOffset="12" XPosition="180" YPosition="136" Width="130" Height="22"/>

      <Relation Name="DEPT_EMP" DetailBlock="EMPLOYEES" JoinCondition="DEPARTMENTS.DEPARTMENT_ID = EMPLOYEES.DEPARTMENT_ID" Deferred="false" AutoQuery="true"/>

      <Trigger Name="WHEN-NEW-RECORD-INSTANCE" TriggerText="-- Keep detail rows synchronized&#10;EXECUTE_QUERY;"/>
    </Block>

    <!-- ==================== DETAIL BLOCK: EMPLOYEES (5 ROWS TABULAR) ==================== -->
    <Block Name="EMPLOYEES" QueryDataSourceName="EMPLOYEES" RecordsDisplayCount="5" DistanceBetweenRecords="4" OrderByClause="EMPLOYEE_ID">
      <Item Name="EMPLOYEE_ID" ItemType="Text Item" DataType="Number" CanvasName="CANVAS4" Prompt="Employee Id" PromptAttachmentEdge="Top" PromptAttachmentOffset="6" XPosition="60" YPosition="225" Width="75" Height="20" PrimaryKey="true" Required="true" ItemsDisplay="5" DistanceBetweenRecords="4"/>
      <Item Name="FIRST_NAME" ItemType="Text Item" DataType="Char" CanvasName="CANVAS4" Prompt="First Name" PromptAttachmentEdge="Top" PromptAttachmentOffset="6" XPosition="145" YPosition="225" Width="125" Height="20" ItemsDisplay="5" DistanceBetweenRecords="4"/>
      <Item Name="HIRE_DATE" ItemType="Text Item" DataType="Date" CanvasName="CANVAS4" Prompt="Hire Date" PromptAttachmentEdge="Top" PromptAttachmentOffset="6" XPosition="280" YPosition="225" Width="85" Height="20" ItemsDisplay="5" DistanceBetweenRecords="4"/>
      <Item Name="JOB_ID" ItemType="Text Item" DataType="Char" CanvasName="CANVAS4" Prompt="Job Id" PromptAttachmentEdge="Top" PromptAttachmentOffset="6" XPosition="375" YPosition="225" Width="80" Height="20" Required="true" ItemsDisplay="5" DistanceBetweenRecords="4"/>
      <Item Name="SALARY" ItemType="Text Item" DataType="Number" CanvasName="CANVAS4" Prompt="Salary" PromptAttachmentEdge="Top" PromptAttachmentOffset="6" XPosition="465" YPosition="225" Width="75" Height="20" ItemsDisplay="5" DistanceBetweenRecords="4"/>
      <Item Name="COMMISSION_PCT" ItemType="Text Item" DataType="Number" CanvasName="CANVAS4" Prompt="Commission Pct" PromptAttachmentEdge="Top" PromptAttachmentOffset="6" XPosition="550" YPosition="225" Width="95" Height="20" ItemsDisplay="5" DistanceBetweenRecords="4"/>

      <Trigger Name="WHEN-VALIDATE-ITEM" TriggerText="IF :EMPLOYEES.SALARY &lt; 0 THEN&#10;  MESSAGE('Error: Salary cannot be negative.');&#10;  RAISE FORM_TRIGGER_FAILURE;&#10;END IF;"/>
    </Block>

    <!-- ==================== PROGRAM UNIT: PAYROLL SUMMARY ==================== -->
    <ProgramUnit Name="CALC_DEPT_TOTAL" ProgramUnitType="Function">
      <Text>FUNCTION calc_dept_total(p_dept_id IN NUMBER) RETURN NUMBER IS
  v_total NUMBER := 0;
BEGIN
  SELECT NVL(SUM(salary), 0)
    INTO v_total
    FROM employees
   WHERE department_id = p_dept_id;
  RETURN v_total;
EXCEPTION
  WHEN OTHERS THEN
    RETURN 0;
END;</Text>
    </ProgramUnit>
  </FormModule>
</Module>
